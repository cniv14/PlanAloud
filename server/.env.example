# Set 0.0.0.0 for LAN; expose cloud deployments only behind HTTPS.
PLANALOUD_BIND=127.0.0.1
PLANALOUD_PORT=8765
PLANALOUD_REGISTRATION=true
# Optional shared registration invitation; existing users can still log in.
PLANALOUD_INVITE_CODE=
# Cloud profile: public DNS name pointing at your server.
PLANALOUD_DOMAIN=calendar.example.com

# Authenticated sync body quota in bytes; 0 means no product size quota.
PLANALOUD_MAX_SYNC_BYTES=0

# Authenticated runtime bundle quota: shared by every device/session of one account.
PLANALOUD_RUNTIME_REQUESTS=10
PLANALOUD_RUNTIME_WINDOW_SECONDS=3600

# For a legacy deployment, use the existing Docker volume name here.
# PLANALOUD_DATA_VOLUME=server_dayflow-data
