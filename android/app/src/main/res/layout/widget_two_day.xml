<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/two_day_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_two_day_background">
    <TextView android:id="@+id/two_day_date" android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical" android:text="11.18  周三" android:textSize="16sp" android:textColor="#F1F0FA" android:contentDescription="打开今日日程"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:baselineAligned="false">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:paddingEnd="6dp">
            <TextView android:id="@+id/two_day_today_heading" android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical" android:text="今天" android:textSize="13sp" android:textColor="#B6A0EF"/>
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <ListView android:id="@+id/two_day_today_list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="4dp" android:scrollbars="none"/>
                <TextView android:id="@+id/two_day_today_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:text="暂无安排" android:textColor="#A8A7BC" android:textSize="12sp" android:paddingTop="8dp"/>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="6dp">
            <TextView android:id="@+id/two_day_tomorrow_heading" android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical" android:text="明天" android:textSize="13sp" android:textColor="#B6A0EF"/>
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <ListView android:id="@+id/two_day_tomorrow_list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="4dp" android:scrollbars="none"/>
                <TextView android:id="@+id/two_day_tomorrow_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:text="暂无安排" android:textColor="#A8A7BC" android:textSize="12sp" android:paddingTop="8dp"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>