<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/two_day_item" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical">
    <TextView android:id="@+id/two_day_stripe" android:layout_width="3dp" android:layout_height="match_parent" android:background="#8D78DC" android:importantForAccessibility="no"/>
    <LinearLayout android:id="@+id/two_day_item_open" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="6dp" android:paddingVertical="4dp">
        <TextView android:id="@+id/two_day_item_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F1F0FA" android:textSize="13sp" android:maxLines="2" android:ellipsize="end"/>
        <TextView android:id="@+id/two_day_item_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#A8A7BC" android:textSize="11sp" android:maxLines="2" android:ellipsize="end"/>
    </LinearLayout>
    <TextView android:id="@+id/two_day_item_done" android:layout_width="32dp" android:layout_height="48dp" android:gravity="center" android:text="○" android:textSize="16sp" android:textColor="#B6A0EF" android:contentDescription="完成事项"/>
</LinearLayout>