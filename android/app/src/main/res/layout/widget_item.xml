<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_item" android:background="@drawable/widget_card_clip" android:outlineProvider="background" android:clipToOutline="true" android:layout_width="match_parent" android:layout_height="wrap_content">
<ImageView android:id="@+id/widget_item_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:maxHeight="1dp" android:adjustViewBounds="true" android:importantForAccessibility="no" />
<FrameLayout android:id="@+id/widget_item_animation" android:layout_width="match_parent" android:layout_height="match_parent" android:measureAllChildren="false" android:visibility="gone" android:importantForAccessibility="no" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:gravity="center_vertical" android:paddingHorizontal="5dp">
    <ImageView android:id="@+id/widget_priority_pattern" android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="4dp" android:layout_marginEnd="2dp" android:scaleType="fitCenter" android:contentDescription="重要程度" /><LinearLayout android:id="@+id/widget_item_open" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingVertical="6dp">
        <TextView android:id="@+id/widget_item_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_item_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/widget_item_done" android:layout_width="32dp" android:layout_height="48dp" android:gravity="center" android:text="○" android:textSize="16sp" android:contentDescription="完成" />
</LinearLayout>

</FrameLayout>